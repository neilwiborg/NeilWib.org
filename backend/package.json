{
	"name": "backend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch ./src/server.ts | pino-pretty",
		"build": "rm -rf ./build && tsc",
		"start": "node ./build/server.js",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1161.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"jsdom": "^30.1.3",
		"pino": "^10.4.0",
		"pino-http": "^11.0.0",
		"unsplash-js": "^8.0.1"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.6",
		"pino-pretty": "^13.2.0",
		"tsx": "^4.23.15",
		"typescript": "catalog:"
	}
}
