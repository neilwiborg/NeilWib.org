{
	"name": "root",
	"private": true,
	"packageManager": "pnpm@12.11.2",
	"scripts": {
		"prepare": "lefthook install",
		"dev": "pnpm -r --parallel --stream --filter backend --filter frontend dev",
		"build": "pnpm -r build",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"typecheck": "pnpm -r typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"lefthook": "^2.2.1"
	}
}
