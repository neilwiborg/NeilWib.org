{
	"name": "root",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"setup:pnpm": "bash scripts/setup-corepack.sh",
		"prepare": "lefthook install",
		"dev": "pnpm -r --parallel --stream --filter backend --filter frontend dev",
		"build": "pnpm -r build",
		"backend:package:lambda": "pnpm --filter backend package:lambda",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"typecheck": "pnpm -r typecheck",
		"infra:synth": "pnpm --filter infrastructure synth",
		"infra:diff": "pnpm --filter infrastructure diff",
		"infra:deploy": "pnpm --filter infrastructure deploy",
		"infra:deploy:ci": "pnpm --filter infrastructure deploy:ci"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"lefthook": "^2.2.2"
	}
}
